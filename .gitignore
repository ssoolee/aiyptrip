# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# 공개 전제 값(NEXT_PUBLIC_FIREBASE_*)과 비밀이 아닌 런타임 값은 커밋한다 —
# GitHub Actions 빌드가 이 값들을 필요로 한다.
!.env.production
!functions/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP 스냅샷
.playwright-mcp/

# firebase 에뮬레이터 로그
firebase-debug.log
firestore-debug.log

# firebase 배포 캐시 (hosting deploy가 만든다)
.firebase/

# 배포 산출물 (npm run pack:deploy가 만든다)
/hosting/
/functions/.next/
/functions/public/
/functions/node_modules/

# 에뮬레이터용 시크릿 (functions 에뮬레이터가 읽는다)
/functions/.secret.local
