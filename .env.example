# docs/prd/07-external-api-integration.md 참조.
# 실제 값은 .env.local에 입력하고 커밋하지 마세요.

# AI 추천 로직 (Must) — LLM_PROVIDER: openai(기본) | gemini | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
# 비워두면 gpt-6-luna (품질 우선이면 gpt-6.1-terra)
OPENAI_MODEL=
GEMINI_API_KEY=
# 비워두면 gemini-flash-lite-latest (품질 우선이면 gemini-flash-latest)
GEMINI_MODEL=
ANTHROPIC_API_KEY=
# 비워두면 claude-opus-5
ANTHROPIC_MODEL=

# 지도 렌더링 / 길찾기 / Geocoding / 장소 검색 (Must) — Naver Cloud Platform
# NCP_SEARCH_KEY_*: NAVER API HUB의 '지역 검색'과 '블로그 검색'을 구독한 애플리케이션 키
# (블로그 검색은 장소 상세의 리뷰에 쓴다 — 활성화하지 않으면 401이 오고 리뷰 영역만 빠진다)
# (네이버 개발자센터 검색 API는 2026-07-31부로 신규 발급 종료 → API HUB로 이관).
NCP_SEARCH_KEY_ID=
NCP_SEARCH_KEY=
# Geocoding·Directions용 — Maps 상품을 구독한 애플리케이션 키 (X-NCP-APIGW-API-KEY-ID/KEY).
# 위 키가 API HUB만 구독했다면 Maps용 키를 따로 넣는다.
NCP_MAPS_KEY_ID=
NCP_MAPS_KEY=
# 브라우저 지도 SDK용 — maps.js의 ncpKeyId 파라미터에 들어간다(NCP_MAPS_KEY_ID와 같은 값).
# 공개되어도 안전하며, NCP 콘솔에 Web 서비스 URL(도메인)을 등록해야 지도가 뜬다.
NEXT_PUBLIC_NCP_MAPS_KEY_ID=

# 관광지/숙소 상세, 축제, 반려동물 동반정보 (Must/Should) — 공공데이터포털 TourAPI
TOUR_API_KEY=

# PRD에는 있으나 아직 코드에서 읽지 않아 여기서 뺀 키 — ODSAY_API_KEY(대중교통 길찾기),
# WEATHER_API_KEY(기상청 단기예보), KAKAO_REST_API_KEY(카카오 로그인 — "로그인 보류").
# 해당 기능을 붙일 때 docs/prd/07-external-api-integration.md를 보고 다시 추가한다.

# Firebase (Must)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 생성한 코스를 서버에 저장해 코스 상세 URL을 다시 열 수 있게 한다 (Should).
# App Hosting에서는 서비스 계정이 자동으로 붙어 비워 두면 된다. 로컬에서 저장까지
# 시험하려면 Firebase 콘솔 > 프로젝트 설정 > 서비스 계정에서 받은 키의 경로나 JSON 내용을 넣는다.
# 비어 있으면 저장만 건너뛰고 나머지는 그대로 동작한다. 키 파일은 커밋하지 않는다.
FIREBASE_SERVICE_ACCOUNT_KEY=
