{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "location": "asia-northeast3"
  },
  "hosting": {
    "site": "aiyptrip",
    "redirects": [
      {
        "source": "/",
        "destination": "https://aiyptrip--aiyptrip.asia-east1.hosted.app/",
        "type": 302
      },
      {
        "source": "/:path*",
        "destination": "https://aiyptrip--aiyptrip.asia-east1.hosted.app/:path*",
        "type": 302
      }
    ]
  },
  "apphosting": {
    "backendId": "aiyptrip",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      ".env*",
      ".playwright-mcp",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ]
  }
}
