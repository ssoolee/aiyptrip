{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "location": "asia-northeast3"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "hosting": {
    "site": "aiyptrip",
    "public": "hosting",
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "source": "/", "destination": "/ko", "type": 301 },
      { "source": "/map", "destination": "/ko/map", "type": 301 },
      { "source": "/favorites", "destination": "/ko/favorites", "type": 301 },
      { "source": "/profile", "destination": "/ko/profile", "type": 301 },
      { "source": "/login", "destination": "/ko/login", "type": 301 },
      { "source": "/pet-places", "destination": "/ko/pet-places", "type": 301 },
      { "source": "/course", "destination": "/ko/course", "type": 301 },
      { "source": "/course/:rest*", "destination": "/ko/course/:rest*", "type": 301 }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "function": {
          "functionId": "nextServer",
          "region": "asia-northeast3"
        }
      }
    ]
  }
}
